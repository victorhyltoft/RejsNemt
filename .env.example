# Mapbox public token (restrict it to your Vercel domain in the Mapbox dashboard)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Rejseplanen API 2.0 — from Rejseplan Labs once your access is approved
REJSEPLANEN_API_KEY=
REJSEPLANEN_API_BASE=https://www.rejseplanen.dk/api

# Optional: a passcode that locks the app (recommended so nobody else burns your API quota)
APP_PASSCODE=

# Optional: fake delays for testing without an API key (1 = on)
MOCK_REALTIME=

# Timetable source (default is Rejseplanen's public GTFS file)
GTFS_URL=https://www.rejseplanen.info/labs/GTFS.zip
